# Runtime modes: development, exhibition, pilot, production.
# Development is the local default. Pilot/production fail closed without auth.
OPTIVOX_RUNTIME_MODE=development
OPTIVOX_DATABASE_PATH=security.db
OPTIVOX_RUNTIME_DIR=runtime
OPTIVOX_TIMEZONE=Asia/Jakarta
OPTIVOX_FRONTEND_ORIGIN=http://127.0.0.1:5173
OPTIVOX_HOST=127.0.0.1
OPTIVOX_PORT=8000
OPTIVOX_DEMO_MODE=false
OPTIVOX_COMMAND_PIN=
OPTIVOX_COOKIE_SECURE=false
OPTIVOX_API_KEY=
OPTIVOX_ADMIN_KEY=
# Optional durable local users. Set both username and password to bootstrap one.
OPTIVOX_ADMIN_USERNAME=
OPTIVOX_ADMIN_PASSWORD=
OPTIVOX_OPERATOR_USERNAME=
OPTIVOX_OPERATOR_PASSWORD=
OPTIVOX_DEVICE_ID=local-edge-cam-0
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
VITE_USE_DEMO_DATA=false
