# Runtime modes: development, exhibition, pilot, production.
# Development is the local default. Pilot/production fail closed without auth.
OPTIVOX_RUNTIME_MODE=development
OPTIVOX_DATABASE_PATH=security.db
OPTIVOX_RUNTIME_DIR=runtime
OPTIVOX_BACKUP_DIR=backups
OPTIVOX_EVIDENCE_RETENTION_DAYS=30
# Development may leave this empty. Pilot/production require a base64url 32-byte key.
OPTIVOX_BIOMETRIC_KEY=
OPTIVOX_TIMEZONE=Asia/Jakarta
OPTIVOX_FRONTEND_ORIGIN=http://127.0.0.1:5173
OPTIVOX_HOST=127.0.0.1
OPTIVOX_PORT=8000
OPTIVOX_DEMO_MODE=false
OPTIVOX_COMMAND_PIN=
OPTIVOX_MAX_REQUEST_BODY_BYTES=1048576
OPTIVOX_COOKIE_SECURE=false
OPTIVOX_API_KEY=
OPTIVOX_ADMIN_KEY=
# Optional durable local users. Set both username and password to bootstrap one.
OPTIVOX_ADMIN_USERNAME=
OPTIVOX_ADMIN_PASSWORD=
OPTIVOX_OPERATOR_USERNAME=
OPTIVOX_OPERATOR_PASSWORD=
OPTIVOX_DEVICE_ID=local-edge-cam-0
OPTIVOX_MODEL_MANIFEST=models/model_checksums.json
OPTIVOX_INSIGHTFACE_ROOT=~/.insightface
OPTIVOX_FACE_MODEL_MANIFEST=~/.insightface/models/buffalo_l/model_checksums.json
OPTIVOX_ALLOWED_WEBHOOK_HOSTS=
OPTIVOX_CAMERA_FREEZE_SECONDS=5
# Optional alert credentials/destinations. Prefer these over alert_config.json.
OPTIVOX_SMTP_SERVER=smtp.gmail.com
OPTIVOX_SMTP_USER=
OPTIVOX_SMTP_PASS=
OPTIVOX_SMTP_FROM=
OPTIVOX_SMTP_TO=
OPTIVOX_TELEGRAM_BOT_TOKEN=
OPTIVOX_TELEGRAM_CHAT_ID=
OPTIVOX_WEBHOOK_URL=
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
VITE_USE_DEMO_DATA=false
