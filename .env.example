# Runtime modes: development, exhibition, pilot, production.
# Development is the local default. Pilot/production fail closed without auth.
OPTIVOX_RUNTIME_MODE=development
# Strict pilot/production defaults are FULL and ON. Development may use
# NORMAL/OFF for speed, but never use OFF for sensitive deployments.
OPTIVOX_SQLITE_SYNCHRONOUS=NORMAL
OPTIVOX_SQLITE_SECURE_DELETE=OFF
OPTIVOX_DATABASE_PATH=security.db
# Capacity guardrails prevent silent disk exhaustion. Tune them for the site.
OPTIVOX_DATABASE_MAX_BYTES=4294967296
OPTIVOX_DATABASE_WARN_BYTES=3221225472
OPTIVOX_DATABASE_WAL_MAX_BYTES=536870912
OPTIVOX_DATABASE_MIN_FREE_BYTES=268435456
# Standard SQLite is retained for development. Pilot/production require an
# installed SQLCipher-compatible driver and a key kept outside the repository.
OPTIVOX_DATABASE_ENCRYPTION_ENABLED=false
OPTIVOX_DATABASE_ENCRYPTION_DRIVER=sqlcipher
OPTIVOX_DATABASE_ENCRYPTION_KEY=
OPTIVOX_RUNTIME_DIR=runtime
OPTIVOX_BACKUP_DIR=backups
OPTIVOX_BACKUP_SIGNING_KEY=
OPTIVOX_BACKUP_ENCRYPTION_ENABLED=false
# Separate from the biometric and manifest-signing keys. Required when backup
# encryption is enabled; losing it makes encrypted backups unrecoverable. Pilot
# and production enable encryption by default.
OPTIVOX_BACKUP_ENCRYPTION_KEY=
OPTIVOX_BACKUP_ENCRYPTION_KEY_ID=primary
# Optional JSON key ring for controlled rotation, maximum four entries:
# {"primary":"...32+ characters...","previous":"...32+ characters..."}
OPTIVOX_BACKUP_ENCRYPTION_KEYS_JSON=
OPTIVOX_AUDIT_SIGNING_KEY=
# Optional isolated backup worker. It is disabled by default; enable only when
# signed backup storage and a tested recovery policy are available.
OPTIVOX_BACKUP_SCHEDULER_ENABLED=false
OPTIVOX_BACKUP_INTERVAL_MINUTES=60
OPTIVOX_BACKUP_MAX_AGE_MINUTES=180
OPTIVOX_EXTERNAL_BACKUP_CONFIRMED=false
OPTIVOX_BACKUP_RETENTION_COUNT=24
OPTIVOX_BACKUP_RETENTION_DAYS=30
OPTIVOX_SYNC_ENABLED=false
OPTIVOX_SYNC_ENDPOINT=
OPTIVOX_SYNC_SECRET=
OPTIVOX_SYNC_ALLOWED_HOSTS=
# Optional stronger edge-to-control-plane request authentication. The receiver
# stores the matching public key in OPTIVOX_SYNC_DEVICE_REGISTRY_JSON. The
# existing OPTIVOX_SYNC_SECRET remains required for record-chain compatibility.
OPTIVOX_SYNC_PRIVATE_KEY_PATH=
OPTIVOX_SYNC_KEY_ID=
OPTIVOX_SYNC_DEVICE_REGISTRY_JSON=
OPTIVOX_SYNC_BATCH_SIZE=50
OPTIVOX_SYNC_TIMEOUT_SECONDS=10
OPTIVOX_EVIDENCE_RETENTION_DAYS=30
# Evidence snapshots use a separate AES-GCM key from biometric and backup keys.
# Pilot/production require this to be enabled; development/exhibition may leave
# it disabled for compatibility with existing local JPEG snapshots.
OPTIVOX_EVIDENCE_ENCRYPTION_ENABLED=false
OPTIVOX_EVIDENCE_ENCRYPTION_KEY=
OPTIVOX_EVIDENCE_ENCRYPTION_KEY_ID=primary
# Optional JSON key ring for rotation, maximum four entries.
OPTIVOX_EVIDENCE_ENCRYPTION_KEYS_JSON=
# Development may leave this empty. Pilot/production require a base64url 32-byte key.
OPTIVOX_BIOMETRIC_KEY=
OPTIVOX_TIMEZONE=Asia/Jakarta
OPTIVOX_FRONTEND_ORIGIN=http://127.0.0.1:5173
OPTIVOX_HOST=127.0.0.1
OPTIVOX_PORT=8000
OPTIVOX_DEMO_MODE=false
OPTIVOX_COMMAND_PIN=
OPTIVOX_MAX_REQUEST_BODY_BYTES=1048576
OPTIVOX_COOKIE_SECURE=false
OPTIVOX_API_KEY=
OPTIVOX_ADMIN_KEY=
# Optional durable local users. Set both username and password to bootstrap one.
OPTIVOX_ADMIN_USERNAME=
OPTIVOX_ADMIN_PASSWORD=
OPTIVOX_OPERATOR_USERNAME=
OPTIVOX_OPERATOR_PASSWORD=
OPTIVOX_DEVICE_ID=local-edge-cam-0
OPTIVOX_SITE_ID=local-site
OPTIVOX_ORGANIZATION_ID=local-organization
OPTIVOX_MODEL_MANIFEST=models/model_checksums.json
OPTIVOX_INSIGHTFACE_ROOT=~/.insightface
OPTIVOX_FACE_MODEL_MANIFEST=~/.insightface/models/buffalo_l/model_checksums.json
OPTIVOX_ALLOWED_WEBHOOK_HOSTS=
OPTIVOX_CAMERA_FREEZE_SECONDS=5
# Optional alert credentials/destinations. Prefer these over alert_config.json.
OPTIVOX_SMTP_SERVER=smtp.gmail.com
OPTIVOX_SMTP_USER=
OPTIVOX_SMTP_PASS=
OPTIVOX_SMTP_FROM=
OPTIVOX_SMTP_TO=
OPTIVOX_TELEGRAM_BOT_TOKEN=
OPTIVOX_TELEGRAM_CHAT_ID=
OPTIVOX_WEBHOOK_URL=
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
VITE_USE_DEMO_DATA=false
